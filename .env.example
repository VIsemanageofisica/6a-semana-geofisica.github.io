# Copia este archivo a .env y completa los valores reales.
# IMPORTANTE: estos valores se exponen en el bundle del navegador (no son secretos),
# pero el archivo .env NO debe commitearse (ya está en .gitignore).

VITE_EMAILJS_PUBLIC_KEY=TU_CLAVE_PUBLICA_EMAILJS
VITE_EMAILJS_SERVICE_ID=TU_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ASISTENTE_ID=TU_TEMPLATE_ASISTENTE_ID
VITE_EMAILJS_TEMPLATE_ORGANIZADOR_ID=TU_TEMPLATE_ORGANIZADOR_ID
VITE_EMAILJS_ORGANIZADOR_EMAIL=tu_correo@organizador.com
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_DEPLOYMENT/exec
